#!/usr/bin/env python3
"""Copy the shared agent setup from dotclaude into a repo, so cloud and
dispatched agents get the same rules and guards as local sessions.

    factory-sync [--check] [repo ...]     default: every git repo in ~/repos/apps
                                          (skip one with a .claude/factory-sync-skip file)

Writes, inside each repo:
  .claude/rules/shared/*.md    shared rules (generated; edit them in dotclaude)
  .claude/hooks/shared/*       guard hooks
  .claude/skills/<name>/       shared skills from factory/skills, only those the
                               repo lists in .claude/factory-sync.json {"skills": [...]}
  .claude/settings.json        claudeMdExcludes for the global copies, so a
                               local session does not load a rule twice; hook
                               entries that defer to ~/.claude/hooks when present
--check exits 1 when a repo is out of date (writes nothing).
--quiet prints only repos that are out of date (used by the SessionStart hook).
"""
import json, os, shutil, sys
from pathlib import Path

DOT = Path(__file__).resolve().parent.parent
APPS = Path.home() / "repos" / "apps"
RULES = ["svelte5", "forms", "tailwind", "motion", "ux-accessibility", "ux-content",
         "drizzle-supabase", "comments", "docs-conventions", "factory-workflow"]
VENDOR_ONLY_RULES = {"core": DOT / "factory" / "core.md"}
HOOKS = {  # file -> (event, matcher, runner, extra)
    "no-secrets.py": ("PreToolUse", "Write|Edit|MultiEdit", "python3", {}),
    "protect-files.sh": ("PreToolUse", "Write|Edit|MultiEdit", "bash", {}),
    "drizzle-migration-guard.py": ("PreToolUse", "Write|Edit|MultiEdit", "python3", {}),
    "stop-verify-and-log.py": ("Stop", None, "python3", {"asyncRewake": True}),
}
FACTORY_HOOKS = {"remote-setup.sh": ("SessionStart", None, "bash", {"timeout": 600})}
MARK = ".claude/hooks/shared/"
MANIFEST = ".claude/skills/.factory-sync"
HEADER = "<!-- Generated by dotclaude/scripts/factory-sync from {src}. Edit it there, then re-run the sync. -->\n"

def with_header(text, src):
    h = HEADER.format(src=src)
    if text.startswith("---\n"):
        end = text.index("\n---\n", 4) + 5
        return text[:end] + h + text[end:]
    return h + text

def wanted(repo: Path):
    files = {}
    for r in RULES:
        files[f".claude/rules/shared/{r}.md"] = with_header((DOT / "rules" / f"{r}.md").read_text(), f"rules/{r}.md")
    for name, src in VENDOR_ONLY_RULES.items():
        files[f".claude/rules/shared/{name}.md"] = with_header(src.read_text(), f"factory/{src.name}")
    for h in HOOKS:
        files[MARK + h] = (DOT / "hooks" / h).read_text()
    for h in FACTORY_HOOKS:
        files[MARK + h] = (DOT / "factory" / "hooks" / h).read_text()
    cfg = repo / ".claude" / "factory-sync.json"
    skills = json.loads(cfg.read_text()).get("skills", []) if cfg.exists() else []
    for name in skills:
        src = DOT / "factory" / "skills" / name
        if not src.is_dir():
            sys.exit(f"{repo.name}: unknown shared skill '{name}' (not in factory/skills)")
        for f in sorted(src.rglob("*")):
            if f.is_file():
                rel = f".claude/skills/{name}/{f.relative_to(src)}"
                text = f.read_text()
                files[rel] = with_header(text, f"factory/skills/{name}/{f.relative_to(src)}") if f.name == "SKILL.md" else text
    if skills or (repo / MANIFEST).exists():
        files[MANIFEST] = "# Skills managed by dotclaude/scripts/factory-sync. Do not edit them here.\n" + "".join(f"{s}\n" for s in skills)
    sp = repo / ".claude" / "settings.json"
    s = json.loads(sp.read_text()) if sp.exists() else {}
    # Absolute paths to the global copies only. A "**/.claude/rules/<name>.md"
    # glob also matched the repo's own rule of that name and hid it.
    # ~/.claude/rules is a symlink to dotclaude/rules, so exclude both spellings.
    ours = [str(base / f"{r}.md") for base in (Path.home() / ".claude" / "rules", DOT / "rules") for r in RULES]
    legacy = {f"**/.claude/rules/{r}.md" for r in RULES}
    ex = [e for e in s.get("claudeMdExcludes", []) if e not in ours and e not in legacy] + ours
    s["claudeMdExcludes"] = ex
    hooks = s.setdefault("hooks", {})
    for ev in list(hooks):  # drop old generated entries, keep the repo's own
        groups = []
        for g in hooks[ev]:
            g["hooks"] = [x for x in g.get("hooks", []) if MARK not in x.get("command", "")]
            if g["hooks"]:
                groups.append(g)
        hooks[ev] = groups
    for name, (ev, matcher, runner, extra) in {**HOOKS, **FACTORY_HOOKS}.items():
        local = f'"$HOME/.claude/hooks/{name}"'
        run = f'{runner} "$CLAUDE_PROJECT_DIR/{MARK}{name}"'
        cmd = run if name in FACTORY_HOOKS else f"[ -e {local} ] || {run}"
        entry = {"type": "command", "command": cmd, **extra}
        grp = next((g for g in hooks.setdefault(ev, []) if g.get("matcher") == matcher), None)
        if grp is None:
            grp = {"hooks": []} if matcher is None else {"matcher": matcher, "hooks": []}
            hooks[ev].append(grp)
        grp["hooks"].append(entry)
    s["hooks"] = {k: v for k, v in hooks.items() if v}
    files[".claude/settings.json"] = json.dumps(s, indent="\t") + "\n"
    return files

def sync(repo: Path, check: bool):
    changed = []
    mf = repo / MANIFEST  # read before writing: it names the skills managed until now
    managed = [l.strip() for l in mf.read_text().splitlines() if l.strip() and not l.startswith("#")] if mf.exists() else []
    files = wanted(repo)
    for rel, text in files.items():
        p = repo / rel
        if not p.exists() or p.read_text() != text:
            changed.append(rel)
            if not check:
                p.parent.mkdir(parents=True, exist_ok=True)
                p.write_text(text)
                if rel.endswith((".sh", ".py")) and MARK in rel:
                    p.chmod(0o755)
    if managed:  # skills this script managed before but the repo no longer lists
        for name in managed:
            d = repo / ".claude" / "skills" / name
            for p in sorted(d.rglob("*"), reverse=True) if d.exists() else []:
                rel = str(p.relative_to(repo))
                if p.is_file() and rel not in files:
                    changed.append(rel + " (remove)")
                    if not check:
                        p.unlink()
                elif p.is_dir() and not check and not any(p.iterdir()):
                    p.rmdir()
            if d.exists() and not check and not any(d.iterdir()):
                d.rmdir()
    for d in ("rules/shared", "hooks/shared"):  # files no longer shared
        for p in (repo / ".claude" / d).glob("*") if (repo / ".claude" / d).exists() else []:
            rel = str(p.relative_to(repo))
            if rel not in files:
                changed.append(rel + " (remove)")
                if not check:
                    p.unlink()
    return changed

if __name__ == "__main__":
    args = sys.argv[1:]
    check = "--check" in args
    quiet = "--quiet" in args
    targets = [Path(a).resolve() for a in args if a not in ("--check", "--quiet")] or sorted(p for p in APPS.iterdir() if (p / ".git").exists() and not (p / ".claude" / "factory-sync-skip").exists())
    bad = 0
    for repo in targets:
        ch = sync(repo, check)
        if quiet and ch:
            print(f"{repo.name}: shared agent files are behind dotclaude ({len(ch)} files). Tell Piotrek; the fix is `factory-sync {repo}` and a commit.")
        elif not quiet:
            print(f"{repo.name}: {'up to date' if not ch else ('out of date: ' if check else 'updated: ') + ', '.join(ch)}")
        bad += bool(ch)
    sys.exit(1 if check and bad else 0)
